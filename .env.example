# TMDB credentials - copy this file to .env.local and fill in ONE of the options.
# Get credentials at https://www.themoviedb.org/settings/api

# Option 1: v4 API Read Access Token (preferred)
TMDB_READ_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9.your_read_access_token
# Option 2: v3 API Key
TMDB_API_KEY=your_api_key
